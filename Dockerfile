# Используем стабильную версию Node.js
FROM node:20-alpine

# Указываем рабочую директорию внутри контейнера
WORKDIR /usr/src/app

# Копируем файлы манифеста зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь исходный код приложения
COPY . .

# Открываем порт, который слушает ваше Node.js приложение
EXPOSE 3000

# Команда для запуска приложения
CMD ["node", "index.js"]
